# ==============================================================================
# OSCAR Frontend - Environment Configuration Template
# Copy to .env.local for local development.
# ==============================================================================

# API Routing
# Client-side base URL: set to /api/v1 to use Next.js same-origin rewrite proxy
NEXT_PUBLIC_API_URL=/api/v1

# Backend Internal URL (used by Next.js rewrites proxy in next.config.mjs)
# Local:  http://127.0.0.1:43101 (explicit IPv4 avoids other localhost listeners)
# Render: http://oscar-backend:10000 (or https://your-backend.onrender.com)
BACKEND_INTERNAL_URL=http://127.0.0.1:43101

# Supabase Client Credentials (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[key]
